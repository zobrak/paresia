# romulus.service — Romulus : point de contact de l'administration (backend-admin).
# SPDX-License-Identifier: AGPL-3.0-or-later
# Rôle : démon (python3 -m server.romulus) : présence reçue de Pollux, HTTP local pour le serveur
#   web. Compte dédié sans shell (D21), sans capacité, système de fichiers en lecture seule,
#   AF_UNIX seulement. Isolation reprise de bunkerd.service 1.3.0.
# Installation : deploy/backend-admin/installer-backend-admin.sh (comptes, groupes, configuration).
# Configuration : couches /etc/paresia/paresia.conf et conf.d/ (D29, D43), lues par le programme ;
#   aucun chemin de configuration, aucun argument et aucune variable PARESIA_* dans cette unité.
# Redémarrer ou arrêter cette unité ferme TOUTES les sessions de présence (D9) : Pollux les ferme
#   dès qu'il perd Romulus.
# Pas de dépendance de démarrage envers pollux.service (D14).
# Suivi des versions
#   0.1.19  2026-11-08  Démarrage du tunnel avec le service, dépendance faible.
#   0.1.2  2026-11-07  StateDirectory=paresia-romulus, StateDirectoryMode=0711 (métriques sous ProtectSystem=strict).
#   0.1.1  2026-11-07  Type=notify, NotifyAccess=main, RestartPreventExitStatus=, TimeoutStartSec=.
#   0.1.0  2026-11-07  Chemin cité : le script d'installation remplace la procédure pas à pas.
#   3.0.0-alpha.29  2026-11-06  Première version (D40, D41, D42).
#   3.0.0-alpha.39  2026-11-06  Nom en minuscules de la procédure.

[Unit]
Description=Paresia : Romulus (point de contact de l'administration)

# systemd.unit(5) : dépendance faible, un tunnel défaillant ou absent ne bloque pas le démon ;
# After= règle seulement l'ordre de démarrage.
Wants=paresia-tunnel.service
After=paresia-tunnel.service

[Service]
Type=notify
User=paresia-romulus
Group=paresia-romulus
# Groupes des sockets que Romulus crée (paresia-liaison, paresia-http : chown) et de celle de
# Pollux qu'il joint (paresia-liaison) ; rien d'autre (D41).
SupplementaryGroups=paresia-liaison paresia-http
Environment=PYTHONPATH=/usr/local/lib/paresia
ExecStart=/usr/bin/python3 -P -s -B -m server.romulus
Restart=on-failure
RestartSec=5
# Type=notify : le démon envoie READY=1 une fois ses sockets liées (sd_notify(3)). NotifyAccess=main
# n'accepte que le processus principal (systemd.service(5)). 64 (usage), 65 (données) et 78
# (configuration) sont des erreurs permanentes : aucun redémarrage automatique. Pas de
# WatchdogSec= (D146). TimeoutStartSec= : la liaison des sockets est immédiate, 30 s bornent l'attente de READY=1.
NotifyAccess=main
RestartPreventExitStatus=64 65 78
TimeoutStartSec=30

# Sockets /run/paresia-romulus/romulus.sock et romulus-http.sock : un dossier par unité, recréé à
# chaque démarrage et supprimé à l'arrêt (D40). 0711 : traversable, non listable (D41).
RuntimeDirectory=paresia-romulus
RuntimeDirectoryMode=0711
# Dossier d'état /var/lib/paresia-romulus, propre au compte de l'unité, pour les métriques (inactives par
# défaut). systemd.exec(5) : StateDirectory= et les réglages voisins « also exclude the specific
# directories from the effect of ProtectSystem= » ; le dossier appartient à User= et Group=, n'est pas
# supprimé à l'arrêt, et reçoit StateDirectoryMode= (défaut 0755) : 0711, traversable, non listable.
StateDirectory=paresia-romulus
StateDirectoryMode=0711
# /etc/paresia reste à root (non attribué au compte du service, systemd.exec(5)), 0755.
# « ::ro » exige systemd >= 257 : le retirer sur une cible plus ancienne (procédure, étape 10).
ConfigurationDirectory=paresia::ro
ConfigurationDirectoryMode=0755
UMask=0077
# Les jetons de session ne doivent jamais aller sur disque.
MemorySwapMax=0

# Isolation
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# MemoryDenyWriteExecute= est volontairement absent : risque avec les bibliothèques de la preuve
# par signature.

[Install]
WantedBy=multi-user.target
