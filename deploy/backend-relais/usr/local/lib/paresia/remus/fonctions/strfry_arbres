"""Arbres negentropy en lecture seule (`negentropy list`).

Aucun fichier, aucun réseau, aucun sudo écrit ici : le préfixe de privilège vient de Remus
(variable PARESIA_PRIVILEGE). La sortie d'erreur de la commande n'est jamais renvoyée.
"""
import json
import os
import re
import subprocess
import sys

DELAI_S = 30
LIGNE_MAX = 512
LIGNES_MAX = 64
SORTIE_MAX = 65536
ARGUMENTS = ['exec', 'strfry', '/app/strfry', 'negentropy', 'list']


def sortir(objet, code):
    sys.stdout.write(json.dumps(objet, separators=(',', ':')))
    sys.stdout.flush()
    sys.exit(code)


def echec():
    sortir({'ok': False, 'error': {'code': 'command_failed'}}, 1)


def prefixe():
    """Préfixe de privilège fourni par Remus (liste JSON), jamais écrit ici."""
    try:
        elements = json.loads(os.environ.get('PARESIA_PRIVILEGE', ''))
    except ValueError:
        echec()
    if (type(elements) is not list or len(elements) < 2
            or any(type(e) is not str or not e or '\0' in e for e in elements)
            or not elements[0].startswith('/')):
        echec()
    return elements


def lancer():
    try:
        if json.loads(sys.stdin.read(64)) != {}:
            echec()
    except ValueError:
        echec()
    try:
        fini = subprocess.run(prefixe() + ARGUMENTS, shell=False, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                              env={'LC_ALL': 'C'}, cwd='/', timeout=DELAI_S, check=False)
    except (OSError, subprocess.SubprocessError):
        echec()
    if fini.returncode != 0 or len(fini.stdout) > SORTIE_MAX:
        echec()
    try:
        return fini.stdout.decode('utf-8')
    except UnicodeError:
        echec()


def filtrer(ligne):
    return ''.join(c for c in ligne if ord(c) >= 32 and not 127 <= ord(c) <= 159)


def main():
    texte = lancer()
    lignes = [filtrer(l).rstrip() for l in texte.split('\n')]
    while lignes and not lignes[-1]:
        lignes.pop()
    reconnu = re.compile(r'(tree [0-9A-Za-z_.:-]{1,128}|\s+(filter|size|fingerprint): .{0,400})\Z')
    if len(lignes) > LIGNES_MAX or any(not reconnu.match(l) for l in lignes):
        echec()
    sortir({'ok': True, 'data': {'lines': [l[:LIGNE_MAX] for l in lignes]}}, 0)


main()
