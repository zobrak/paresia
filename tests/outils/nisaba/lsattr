#!/bin/sh
# Simulacre de lsattr pour les tests de Nisaba (jamais le vrai lsattr) : « lsattr -d -- CHEMIN... ».
# Un fichier est « immuable » s'il n'est pas inscriptible (mode 444) ; absent : message sur la sortie
# d'erreur, code 1 en fin de course (comme lsattr).
[ "$1" = "-d" ] && [ "$2" = "--" ] && [ -n "$3" ] || exit 2
shift 2
code=0
for f in "$@"; do
  if [ ! -e "$f" ]; then code=1; continue; fi
  mode=$(stat -c %a "$f")
  if [ "$mode" = "444" ]; then printf -- '----i---------e------- %s\n' "$f"; else printf -- '--------------e------- %s\n' "$f"; fi
done
exit $code
